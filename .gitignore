# Never commit Accsoon's apps or decompiled code
*.apk
*.xapk
*.apks
*.ipa
*.app/
decompiled/
vendor-bin/

# Captures contain real camera footage. They stay local by default;
# remove these lines to commit a capture on purpose.
capture.bin
*.pcap
captures/*
!captures/.gitkeep

# macOS / Xcode / SwiftPM
.DS_Store
xcuserdata/
DerivedData/
build/
.build/
.swiftpm/

# Python
__pycache__/
*.pyc
.venv/
